   "title_he": "סַמְסוּנְג וְגוּגֶל מַצִּיגוֹת מִשְׁקְפֵי בִּינָה מְלָאכוּתִית חֲדָשִׁים"
  },
  {
   "id": "2026-11-15-culture",
   "date": "2026-11-15",
   "category": "Культура",
   "level": 3,
   "cefr": "B1–B2",
   "title_ru": "Филиппины победили на первом азиатском конкурсе Евровидение",
   "title_plain": "הפיליפינים ניצחה בתחרות אירוויזיון אסיה הראשונה",
   "sentences": [
    {
     "plain": "תחרות הזמר הבינלאומית \"אירוויזיון אסיה\" התקיימה השנה בפעם הראשונה בהיסטוריה בהשתתפות מדינות רבות.",
     "ru": "Международный песенный конкурс «Евровидение Азия» состоялся в этом году впервые в истории с участием многих стран.",
     "he": "תַּחֲרוּת הַזֶּמֶר הַבֵּינְלְאֻומִּית \"אֵירוֹוִיזְיוֹן אַסְיָה\" הִתְקַיְּימָה הַשָּׁנָה בַּפַּעַם הָרִאשׁוֹנָה בַּהִיסְטוֹרְיָה בְּהִשְׁתַּתְּפוּת מְדִינוֹת רַבּוֹת.",
     "audio": "audio/2026-11-15/d5268eccfc82a069.mp3"
    },
    {
     "plain": "נציגת הפיליפינים הצליחה להרשים את השופטים והקהל וזכתה במקום הראשון בתחרות המוזיקה.",
     "ru": "Представительница Филиппин сумела впечатлить судей и зрителей и заняла первое место в музыкальном конкурсе.",
     "he": "נְצִיגַת הַפִילִיפִּינִים הִצְלִיחָה לְהַרְשִׁים אֶת הַשּׁוֹפְטִים וְהַקָּהָל וְזָכְתָה בַּמָּקוֹם הָרִאשׁוֹן בְּתַחֲרוּת הַמּוּזִיקָה.",
     "audio": "audio/2026-11-15/05f6ee45846e9e89.mp3"
    },
    {
     "plain": "התחרות החדשה נועדה לחבר בין תרבויות שונות ברחבי יבשת אסיה באמצעות שירים והופעות.",
     "ru": "Новый конкурс был призван объединить различные культуры на азиатском континенте с помощью песен и выступлений.",
     "he": "הַתַּחֲרוּת הַחֲדָשָׁה נוֹעֲדָה לְחַבֵּר בֵּין תַּרְבּוּיוֹת שׁוֹנוֹת בְּרַחֲבֵי יַבֶּשֶׁת אַסְיָה בְּאֶמְצָעוּת שִׁירִים וְהוֹפָעוֹת.",
     "audio": "audio/2026-11-15/4a36d0fad01e980b.mp3"
    },
    {
     "plain": "אמנים מכל רחבי האזור הגיעו כדי להציג את כישרונם המוזיקלי מול מיליוני צופים.",
     "ru": "Артисты со всего региона приехали, чтобы продемонстрировать свой музыкальный талант перед миллионами зрителей.",
     "he": "אׇמָּנִים מִכׇּל רַחֲבֵי הָאֵזוֹר הִגִּיעוּ כְּדֵי לְהַצִּיג אֶת כִּישְׁרוֹנָם הַמּוּזִיקָלִי מוּל מִילְיוֹנֵי צוֹפִים.",
     "audio": "audio/2026-11-15/c7fdae3136a12451.mp3"
    },
    {
     "plain": "ההפקה של האירוע הגדול כללה במות מתקדמות, תאורה מרשימה ושידור ישיר למדינות רבות.",
     "ru": "Производство этого грандиозного события включало современные сцены, впечатляющее освещение и прямую трансляцию во многие страны.",
     "he": "הַהֲפָקָה שֶׁל הָאֵירוּעַ הַגָּדוֹל כָּלְלָה בַּמוֹת מִתְקַדְּמוֹת, תְּאוּרָה מַרְשִׁימָה וְשִׁידּוּר יָשִׁיר לִמְדִינוֹת רַבּוֹת.",
     "audio": "audio/2026-11-15/2d81bf393e186ce1.mp3"
    },
    {
     "plain": "הקהל באולם הגיב בהתלהבות רבה להופעה המנצחת, ששילבה סגנון מודרני עם אלמנטים מסורתיים.",
     "ru": "Публика в зале с большим восторгом отреагировала на победное выступление, сочетавшее современный стиль с традиционными элементами.",
     "he": "הַקָּהָל בָּאוּלָם הֵגִיב בְּהִתְלַהֲבוּת רַבָּה לַהוֹפָעָה הַמְּנַצַּחַת, שֶׁשִּׁילְּבָה סִגְנוֹן מוֹדֶרְנִי עִם אֵלֵמֶנְטִים מָסׇורְתִּיִּים.",
     "audio": "audio/2026-11-15/f02c4c28cd9db9ea.mp3"
    },
    {
     "plain": "הזכייה עוררה שמחה וגאווה רבה בפיליפינים, שם עקבו בהתרגשות אחרי שלבי התחרות.",
     "ru": "Победа вызвала огромную радость и гордость на Филиппинах, где с волнением следили за этапами конкурса.",
     "he": "הַזְּכִיָּיה עוֹרְרָה שִׂמְחָה וְגַאֲוָוה רַבָּה בַּפִילִיפִּינִים, שָׁם עָקְבוּ בְּהִתְרַגְּשׁוּת אַחֲרֵי שְׁלַבֵּי הַתַּחֲרוּת.",
     "audio": "audio/2026-11-15/03defca9cb02bd46.mp3"
    },
    {
     "plain": "המארגנים מקווים שהאירוע יהפוך למסורת שנתית קבועה שתפתח דלתות לזמרים צעירים בעולם.",
     "ru": "Организаторы надеются, что мероприятие станет регулярной ежегодной традицией, которая откроет двери молодым певцам в мире.",
     "he": "הַמְּאַרְגְּנִים מְקַוִּוים שֶׁהָאֵירוּעַ יַהֲפֹוךְ לְמָסֹורֶת שְׁנָתִית קְבוּעָה שֶׁתִּפְתַּח דְּלָתוֹת לְזַמָּרִים צְעִירִים בָּעוֹלָם.",
     "audio": "audio/2026-11-15/0c4b7b941293e1a4.mp3"
    }
   ],
