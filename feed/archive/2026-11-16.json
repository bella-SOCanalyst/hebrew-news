   "title_he": "מֶזֶג הָאֲוִויר בְּיִשְׂרָאֵל: הַטֶּמְפֵּרָטוּרוֹת יוֹרְדוֹת אַךְ הַגֶּשֶׁם מִתְעַכֵּב"
  },
  {
   "id": "2026-11-16-tech",
   "date": "2026-11-16",
   "category": "Технологии",
   "level": 3,
   "cefr": "B1–B2",
   "title_ru": "Историческое достижение в космосе: корабль Starship пойман пусковой башней",
   "title_plain": "הישג היסטורי בחלל: חללית סטארשיפ נלכדה במגדל השיגור",
   "sentences": [
    {
     "plain": "חללית הענק סטארשיפ השלימה ניסוי טיסה מרשים במיוחד בחלל וחזרה לכדור הארץ בהצלחה רבה.",
     "ru": "Гигантский космический корабль Starship завершил особенно впечатляющий испытательный полет в космосе и успешно вернулся на Землю.",
     "he": "חֲלָלִית הָעֲנָק סְטַארְשִׁיפּ הִשְׁלִימָה נִיסּוּי טִיסָה מַרְשִׁים בִּמְיֻוחָד בֶּחָלָל וְחָזְרָה לְכַדּוּר הָאָרֶץ בְּהַצְלָחָה רַבָּה.",
     "audio": "audio/2026-11-16/b1b72e7f9cd9a30f.mp3"
    },
    {
     "plain": "במהלך המבצע ההיסטורי הצליח המשגר לחזור בדיוק רב אל אתר השיגור שממנו הוא המריא.",
     "ru": "В ходе исторической операции ракете-носителю удалось с высокой точностью вернуться на стартовую площадку, с которой она взлетела.",
     "he": "בְּמַהֲלַךְ הַמִּבְצָע הַהִיסְטוֹרִי הִצְלִיחַ הַמְּשַׁגֵּר לַחֲזֹור בְּדִיּוּק רַב אֶל אֲתַר הַשִּׁיגּוּר שֶׁמִּמֶּנּוּ הוּא הִמְרִיא.",
     "audio": "audio/2026-11-16/c1e61c432846dab7.mp3"
    },
    {
     "plain": "זרועות מכניות מיוחדות המותקנות על מגדל השיגור תפסו את המשגר הגדול בעודו באוויר.",
     "ru": "Специальные механические манипуляторы, установленные на пусковой башне, поймали большой ускоритель прямо в воздухе.",
     "he": "זְרוֹעוֹת מֵכָנִיּוֹת מְיֻוחָדוֹת הַמֻּותְקָנוֹת עַל מִגְדַּל הַשִּׁיגּוּר תָּפְסוּ אֶת הַמְּשַׁגֵּר הַגָּדוֹל בְּעוֹדוֹ בָּאֲוִויר.",
     "audio": "audio/2026-11-16/5598c5c6a10b4eb5.mp3"
    },
    {
     "plain": "מומחים בתחום התעופה והחלל הגדירו את ההישג ההנדסי הזה כאירוע שנראה כמעט כמו קסם.",
     "ru": "Специалисты в области авиации и космонавтики охарактеризовали это инженерное достижение как событие, выглядящее почти волшебством.",
     "he": "מֻומְחִים בִּתְחוּם הַתְּעוּפָה וְהֶחָלָל הִגְדִּירוּ אֶת הַהֶישֵּׂג הַהַנְדָּסִי הַזֶּה כְּאֵירוּעַ שֶׁנִּרְאֶה כִּמְעַט כְּמוֹ קֶסֶם.",
     "audio": "audio/2026-11-16/d40d76889441e4ad.mp3"
    },
    {
     "plain": "שיטה חדשנית זו נועדה לאפשר שימוש חוזר ומהיר בחלליות ללא צורך בשיפוץ ממושך.",
     "ru": "Этот инновационный метод призван обеспечить быстрое и повторное использование космических кораблей без необходимости длительного ремонта.",
     "he": "שִׁיטָה חַדְשָׁנִית זוֹ נוֹעֲדָה לְאַפְשֵׁר שִׁימּוּשׁ חוֹזֵר וּמָהִיר בַּחֲלָלִיּוֹת לְלֹא צֹורֶךְ בְּשִׁיפּוּץ מְמֻושָּׁךְ.",
     "audio": "audio/2026-11-16/be935ba5c64e124a.mp3"
    },
    {
     "plain": "בעבר נהגו חלקי רקטות ליפול לתוך האוקיינוס ולהיהרס לחלוטין לאחר כל שיגור בודד.",
     "ru": "В прошлом части ракет обычно падали в океан и полностью разрушались после каждого отдельного пуска.",
     "he": "בֶּעָבָר נָהֲגוּ חֶלְקֵי רָקֵטוֹת לִיפֹּול לְתוֹךְ הָאוֹקְיָינוֹס וּלְהֵיהָרֵס לַחֲלוּטִין לְאַחַר כׇּל שִׁיגּוּר בּוֹדֵד.",
     "audio": "audio/2026-11-16/6ae167e0890435f0.mp3"
    },
    {
     "plain": "היכולת להנחית משגרים באופן מדויק צפויה להוזיל באופן משמעותי את עלויות המסע לחלל.",
     "ru": "Способность совершать точную посадку ракет-носителей, как ожидается, существенно снизит затраты на космические полеты.",
     "he": "הַיְּכֹולֶת לְהַנְחִית מְשַׁגְּרִים בְּאֹופֶן מְדֻויָּק צְפוּיָה לְהוֹזִיל בְּאֹופֶן מַשְׁמָעוּתִי אֶת עֲלוּיוֹת הַמַּסָּע לֶחָלָל.",
     "audio": "audio/2026-11-16/541e85787ced01e6.mp3"
    },
    {
     "plain": "חברות טכנולוגיה רבות ברחבי העולם עוקבות בעניין רב אחר ההתפתחויות המהירות בתחום זה.",
     "ru": "Многие технологические компании по всему миру с большим интересом следят за стремительным развитием в этой сфере.",
     "he": "חֶבְרוֹת טֶכְנוֹלוֹגְיָה רַבּוֹת בְּרַחֲבֵי הָעוֹלָם עוֹקְבוֹת בְּעִנְיָין רַב אַחַר הַהִתְפַּתְּחוּיוֹת הַמְּהִירוֹת בִּתְחוּם זֶה.",
     "audio": "audio/2026-11-16/290683c7f4011d85.mp3"
    },
    {
     "plain": "ההצלחה הנוכחית מקרבת את האנושות אל היעד השאפתני של טיסות מאוישות למאדים.",
     "ru": "Нынешний успех приближает человечество к амбициозной цели пилотируемых полетов на Марс.",
     "he": "הַהַצְלָחָה הַנּוֹכְחִית מְקָרֶבֶת אֶת הָאֱנוֹשׁוּת אֶל הַיַּעַד הַשְּׁאַפְתָּנִי שֶׁל טִיסוֹת מְאֻויָּשׁוֹת לְמַאְדִּים.",
     "audio": "audio/2026-11-16/1a6a5469c951a4eb.mp3"
    }
   ],
